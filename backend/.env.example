# Flask
FLASK_ENV=development
SECRET_KEY=change-me-in-production
HOST=0.0.0.0
PORT=5000

# CORS — comma-separated allowed origins
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# Postgres (Neon/Render) — omit for local SQLite-only dev
# DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# Dev seed user UUID (see scripts/migrate_demo_user_id.py)
# DEV_USER_ID=00000000-0000-0000-0000-000000000123

# OpenRouter / LLM
OPENROUTER_API_KEY=your-openrouter-api-key
LLM_TEXT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Tried when the primary errors or is rate-limited (max 3 models total).
LLM_TEXT_FALLBACK_MODELS=nex-agi/nex-n2.5-pro:free,openrouter/free
LLM_VISION_MODEL=google/gemma-4-31b-it:free
LLM_VISION_FALLBACK_MODELS=qwen/qwen3.8-27b:free,openrouter/free
LLM_EMBEDDING_MODEL=openai/text-embedding-3-small

# Supabase Auth (required for protected API routes)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_AUD=authenticated

# Email encryption (optional — falls back to SECRET_KEY)
# EMAIL_ENCRYPTION_KEY=generate-a-long-random-string

# Upload limits
MAX_UPLOAD_MB=10

# Chroma RAG (disable on Render — ephemeral disk)
ENABLE_CHROMA=true

# Google Cloud (optional — only if using Vision API directly)
# GOOGLE_APPLICATION_CREDENTIALS=lumen-service-account.json
