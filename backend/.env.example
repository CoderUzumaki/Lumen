# Lumen backend environment variables.
#
# Copy this file to `.env` (gitignored) and fill in real values:
#     cp .env.example .env
#
# `Config.validate()` runs at app startup and refuses to boot if any of the
# three required variables (SECRET_KEY, OPENROUTER_API_KEY, SUPABASE_URL) is
# unset — in `FLASK_ENV=development` an ephemeral SECRET_KEY is generated for
# you, so only OPENROUTER_API_KEY and SUPABASE_URL are strictly load-bearing
# in dev.
#
# The authoritative list lives in BUILD.md §"Environment variables"; keep this
# file in sync with that section.

# --- Core --------------------------------------------------------------------

# Environment mode. 'development' loosens SECRET_KEY (ephemeral OK) and
# enables debug conveniences. Set to 'production' anywhere it's not literally
# your laptop.
FLASK_ENV=development

# App-wide secret. Required outside 'development' mode; in development an
# ephemeral per-process key is generated when this is unset.
SECRET_KEY=

# Comma-separated list of origins allowed by CORS. Include every frontend
# origin that will call this API.
ALLOWED_ORIGINS=http://localhost:3000

# Async SQLAlchemy connection string. Supabase Postgres in prod; local
# Postgres in dev. Alembic swaps `+asyncpg` for `+psycopg2` for migrations.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lumen

# stdlib log level: DEBUG | INFO | WARNING | ERROR | CRITICAL.
LOG_LEVEL=INFO

# --- Supabase auth -----------------------------------------------------------

# Supabase project URL, e.g. https://<project-ref>.supabase.co. REQUIRED —
# used by `app.utils.auth` to fetch JWKS for token verification.
SUPABASE_URL=https://<project>.supabase.co

# Expected `aud` claim in incoming JWTs. Supabase issues "authenticated" for
# real users; override only if you're on a custom tenant.
SUPABASE_JWT_AUD=authenticated

# --- LLM (OpenRouter, free tier) --------------------------------------------

# OpenRouter API key. REQUIRED — free to obtain at https://openrouter.ai.
OPENROUTER_API_KEY=

# OpenRouter base URL (OpenAI-compatible endpoint). Rarely changes.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Fast tier: the small / fast free-tier model. Used for classification, the
# relevance prefilter, and any high-volume shallow calls.
LLM_TEXT_MODEL_FAST=meta-llama/llama-3.3-70b-instruct:free

# Thorough tier: the strong reasoning free-tier model. Used for impact
# analysis, briefing synthesis, chat.
LLM_TEXT_MODEL_THOROUGH=deepseek/deepseek-chat-v3.1:free

# JSON object mapping model_id -> requests-per-minute cap. Use "default" for
# any model not explicitly listed. Free-tier OpenRouter is typically 20 RPM.
LLM_RATE_LIMIT_RPM={"default":20}

# Fallback paid-tier daily $ ceiling per user. Leave 0.0 to disable paid
# fallback entirely; raise only if free-tier availability degrades.
LLM_DAILY_BUDGET_USD=0.0

# --- Embeddings (local, free) -----------------------------------------------

# sentence-transformers model id. Change only if you're intentionally testing
# a different embedding space (ING-07 documents the compatibility rules).
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# 'cpu' (default) or 'cuda' if you have a GPU available.
EMBEDDING_DEVICE=cpu

# --- Clustering / relevance --------------------------------------------------

# Per-source authority weight in [0, 1]. Feeds ING-09's cluster.authority_score
# (max over member sources). Full JSON object; env-supplied value replaces the
# default map wholesale.
SOURCE_AUTHORITY={"newsapi":0.60,"marketaux":0.60,"gdelt":0.50,"edgar":0.95,"rss":0.70}

# --- News sources ------------------------------------------------------------

# NewsAPI key (100 req/day free tier). Empty → NewsAPI is skipped; ingestion
# still works from the other sources.
NEWSAPI_KEY=

# Marketaux key (~100 req/day free tier). Empty → skipped.
MARKETAUX_KEY=

# GDELT is unlimited-free and always on by default; set to false to disable.
GDELT_ENABLED=true

# SEC EDGAR requires a descriptive User-Agent per their fair-use policy.
EDGAR_USER_AGENT=Lumen contact@example.com

# Comma-separated list of RSS feed URLs to poll. Empty is allowed.
RSS_FEEDS=

# --- Market data -------------------------------------------------------------

# Where yfinance caches downloaded price data. Set to an absolute path with
# write access.
YFINANCE_CACHE_PATH=/app/price_cache

# --- Vector store ------------------------------------------------------------

# Chroma on-disk store path. Set to an absolute path with write access. On
# Fly.io mount a volume here.
CHROMA_PATH=/app/chroma_data

# --- Observability (pick ONE — both are free at portfolio scale) ------------

# Option A: LangSmith (5,000 traces/mo on free tier).
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=lumen-dev
LANGSMITH_TRACING=false

# Option B: Langfuse (free cloud tier or self-host).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Scheduler / pipeline thresholds ----------------------------------------

# How often the ingest pipeline runs. 15 minutes is the MVP cadence.
INGEST_INTERVAL_MINUTES=15

# Cosine similarity threshold for grouping news items into event clusters.
CLUSTER_SIMILARITY_THRESHOLD=0.87

# Cosine similarity threshold below which the relevance prefilter drops an
# item without invoking the LLM classifier.
PREFILTER_THRESHOLD=0.35
