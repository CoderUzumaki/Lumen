# Frontend environment variables.
#
# Copy this file to `.env.local` (which is gitignored) and fill in real values:
#     cp .env.example .env.local
#
# `NEXT_PUBLIC_*` variables are inlined into the client bundle at build time,
# so changing one requires a rebuild. They are visible in the browser — do NOT
# put secrets here.
#
# All three variables are required — `frontend/next.config.ts` fail-fasts if any
# is missing at `next build` / `next dev`.

# Backend API origin. Used by the frontend for every request to the FastAPI
# backend. No trailing slash. Match the port your backend uvicorn is on
# (8000 by default per backend/app/main.py).
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Supabase project URL, e.g. https://<project-ref>.supabase.co.
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co

# Supabase public / anon key. Safe to expose in the browser bundle.
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
