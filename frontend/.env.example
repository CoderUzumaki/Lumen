# Frontend environment variables.
#
# Copy this file to `.env.local` (which is gitignored) and fill in real values:
#     cp .env.example .env.local
#
# `NEXT_PUBLIC_*` variables are inlined into the client bundle at build time,
# so changing one requires a rebuild. They are visible in the browser — do NOT
# put secrets here.

# === Required ===

# Backend API origin. Used by `src/lib/api/client.ts` for every request.
# No trailing slash. Example values:
#   local:   http://localhost:5000
#   staging: https://api.staging.lumen.app
#   prod:    https://api.lumen.app
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000

# Supabase project URL: Supabase dashboard -> Project Settings -> API -> Project URL.
# Must match SUPABASE_URL in backend/.env.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon (public) key: same page -> Project API keys -> `anon` `public`.
# Safe for the browser bundle (row-level security protects data, not key secrecy).
# Never put the `service_role` key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
